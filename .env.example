FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v23.0

# true = show sample posts when no Facebook token is set (for previewing the site)
DEMO_MODE=true

# How long to cache Facebook data, in minutes
CACHE_MINUTES=10
